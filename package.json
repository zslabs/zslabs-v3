    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@vercel/analytics": "2.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "framer-motion": "13.1.0",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "react": "19.2.8",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
